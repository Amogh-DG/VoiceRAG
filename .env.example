# Server configuration
HOST=127.0.0.1
PORT=8000

# LLM provider credentials (placeholders for next implementation steps)
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# Vector DB credentials (placeholders)
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=your-vector-db-key-here

# Sarvam AI API Key for Speech-to-Text (STT)
# Get your API key from https://dashboard.sarvam.ai/
VITE_SARVAM_API_KEY=your sarvam api key

# Backend API Base URL (configured when backend URL is supplied)
VITE_API_BASE_URL=
